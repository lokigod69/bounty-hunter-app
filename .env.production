# Public origin used by invitation links in native production builds.
VITE_PUBLIC_APP_URL=https://bountyhunter.xyz
# Enabled after the hosted disposable-account acceptance run on 2026-09-07.
VITE_ACCOUNT_DELETION_ENABLED=true
VITE_CONTACT_SAFETY_ENABLED=true
# Requires Apple credentials and a verified physical-device delivery before activation.
VITE_PUSH_ENABLED=false
