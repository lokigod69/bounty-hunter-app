VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Required for native invitation sharing. Set to the deployed public HTTPS app origin.
# Web development falls back to the current browser origin when unset.
VITE_PUBLIC_APP_URL=

# Enable only after proposal 018 and delete-account pass the release runbook.
VITE_ACCOUNT_DELETION_ENABLED=false
VITE_CONTACT_SAFETY_ENABLED=false
VITE_PUSH_ENABLED=false
# Must match the signed build's aps-environment entitlement.
VITE_APNS_ENVIRONMENT=production

# Vercel server-only variables. Never prefix these with VITE_.
APNS_ENABLED=false
APNS_ENVIRONMENT=production
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
PUSH_DISPATCH_SECRET=
SUPABASE_URL=https://mvbmpcmexkgfairnthux.supabase.co

# Supabase Edge Function secrets. Configure in Supabase, not in the Vite client.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPABASE_SERVICE_ROLE_KEY=
DAILY_TASKS_SECRET=

# Legacy Gmail notification functions only. Leave unset unless those functions are reviewed and deployed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
